      "expression": "a * d = b * c",
      "meaning": "The ratios are proportional when the cross products are equal."
    },
    "methods": {
      "cross_multiplication": {
        "description": "Compare the cross products of the two ratios.",
        "steps": [
          {
            "operation": "multiply_cross_terms",
