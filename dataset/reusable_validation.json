          },
          {
            "operation": "multiply_cross_terms",
            "expression": "{b} * {c}"
          },
          {
            "operation": "compare_products",
            "condition": "{a} * {d} = {b} * {c}",
            "conclusion_if_true": "The ratios are proportional.",
            "conclusion_if_false": "The ratios are not proportional."
          }
        ]
      },
      "hcf_simplification": {
        "description": "Reduce both ratios to their simplest forms using the reusable HCF function.",
        "steps": [
          {
            "operation": "call_hcf",
            "function": "hcf",
            "arguments": ["{a}", "{b}"],
            "assign_to": "hcf_r1"
          },
          {
            "operation": "call_hcf",
            "function": "hcf",
            "arguments": ["{c}", "{d}"],
            "assign_to": "hcf_r2"
          },
          {
            "operation": "simplify_ratio",
            "expression": "({a}/hcf_r1):({b}/hcf_r1)",
            "assign_to": "simplified_r1"
          },
          {
            "operation": "simplify_ratio",
            "expression": "({c}/hcf_r2):({d}/hcf_r2)",
            "assign_to": "simplified_r2"
          },
          {
            "operation": "compare_simplified_ratios",
            "condition": "simplified_r1 = simplified_r2",
            "conclusion_if_true": "The ratios are proportional.",
            "conclusion_if_false": "The ratios are not proportional."
          }
        ]
      },
      "scaling": {
        "description": "Check whether one ratio is obtained by multiplying the other ratio by the same factor.",
        "steps": [
          {
            "operation": "calculate_scale_factor",
            "expression": "scale_factor = {c}/{a}"
          },
          {
            "operation": "apply_scale_factor",
            "expression": "{b} * scale_factor"
          },
          {
            "operation": "compare_scaled_term",
            "condition": "{b} * scale_factor = {d}",
            "conclusion_if_true": "The ratios are proportional.",
            "conclusion_if_false": "The ratios are not proportional."
          }
        ]
      }
    },
